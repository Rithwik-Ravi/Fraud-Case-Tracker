# MongoDB Database Connection String
# For local development:
# MONGODB_URI="mongodb://127.0.0.1:27017/surakhsa"
# For Vercel Production deployment (MongoDB Atlas):
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/surakhsa?retryWrites=true&w=majority"
MONGODB_DB="surakhsa"

# JWT Secret Key for Session signing
JWT_SECRET="surakhsa_secure_production_secret_key_change_in_production"

# Public App URL
NEXT_PUBLIC_APP_URL="https://surakhsa.vercel.app"
