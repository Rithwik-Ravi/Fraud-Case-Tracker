# MongoDB Database Connection String
# For local development:
# MONGODB_URI="mongodb://127.0.0.1:27017/surakhsa"
# For Vercel Production deployment (MongoDB Atlas):
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/surakhsa?retryWrites=true&w=majority"
MONGODB_DB="Saarthi"

# JWT Secret Key for Session signing
JWT_SECRET="surakhsa_secure_production_secret_key_change_in_production"

# Public App URL
NEXT_PUBLIC_APP_URL="https://casepath-two.vercel.app"

# OpenAI API Key (optional — enables AI-assisted triage and screenshot-based suspect checking)
# Leave blank to use the deterministic rule-based classifier (no external calls).
# When set, /api/triage calls gpt-4o-mini and /api/check-image calls gpt-4o vision.
OPENAI_API_KEY=""
